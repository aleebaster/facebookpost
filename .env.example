# Facebook Posting Bot - Environment Configuration
# Copy this file to .env and fill in your values

# Mode: DRY_RUN, MANUAL_APPROVAL, or AUTO
MODE=DRY_RUN

# Chrome user data directory (do NOT point to a profile folder)
# On Windows: C:\Users\<username>\AppData\Local\Google\Chrome\User Data
CHROME_USER_DATA_DIR=C:\Users\andre\AppData\Local\Google\Chrome\User Data

# Chrome profile directory name within user_data_dir
# This is the folder name inside "User Data", e.g. "Default", "Profile 1", "Profile 2"
CHROME_PROFILE=Profile 2

# Chrome binary path (leave empty for system default)
CHROME_BINARY=

# Post intervals (seconds) - random pause between posts
MIN_POST_INTERVAL=180
MAX_POST_INTERVAL=420

# Action delays (seconds) - pauses between individual actions
PAGE_LOAD_DELAY=5
FORM_DELAY=3
SUBMIT_DELAY=5
SCROLL_DELAY=2

# Content generation
NUMBER_OF_VARIATIONS=6

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
